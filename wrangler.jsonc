{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githua-sales-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
